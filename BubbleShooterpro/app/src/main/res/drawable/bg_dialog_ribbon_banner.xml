<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow -->
    <item
        android:top="4dp"
        android:left="4dp"
        android:right="4dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#40000000" />
        </shape>
    </item>

    <!-- Blue Ribbon Body -->
    <item
        android:top="0dp"
        android:left="0dp"
        android:right="0dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:startColor="#4338CA"
                android:centerColor="#3B82F6"
                android:endColor="#2563EB"
                android:angle="90" />
            <stroke
                android:width="2dp"
                android:color="#93C5FD" />
        </shape>
    </item>
</layer-list>
