<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 3D Base Drop Shadow -->
    <item
        android:top="3dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#40000000" />
        </shape>
    </item>

    <!-- Outer Golden / Azure Bevel Border -->
    <item
        android:top="0dp"
        android:left="0dp"
        android:right="0dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#60A5FA"
                android:endColor="#1D4ED8" />
            <stroke
                android:width="1.8dp"
                android:color="#93C5FD" />
        </shape>
    </item>

    <!-- Main Royal Blue Pill Body -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#2563EB"
                android:centerColor="#1D4ED8"
                android:endColor="#1E40AF" />
        </shape>
    </item>

    <!-- Top Specular Arc Highlight -->
    <item
        android:top="3dp"
        android:left="10dp"
        android:right="10dp"
        android:bottom="16dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#60FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
