<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 3D Shadow -->
    <item android:top="3dp">
        <shape android:shape="oval">
            <solid android:color="#0F172A" />
        </shape>
    </item>
    <!-- Main Circle -->
    <item android:bottom="3dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="40dp"
                android:startColor="#475569"
                android:centerColor="#334155"
                android:endColor="#1E293B" />
            <stroke
                android:width="2dp"
                android:color="#475569" />
        </shape>
    </item>
    <!-- Top Shine Specular -->
    <item android:top="4dp" android:left="8dp" android:right="8dp" android:bottom="20dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#50FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <!-- Centered Vector Lock Icon -->
    <item
        android:width="26dp"
        android:height="26dp"
        android:gravity="center"
        android:bottom="3dp"
        android:drawable="@drawable/ic_lock" />
</layer-list>
