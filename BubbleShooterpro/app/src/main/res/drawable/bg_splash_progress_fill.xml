<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base 3D bevel shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <solid android:color="#0D5E2D" />
        </shape>
    </item>

    <!-- Vibrant glossy green-cyan gradient -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <gradient
                android:angle="0"
                android:startColor="#22C55E"
                android:centerColor="#38EF7D"
                android:endColor="#06B6D4" />
        </shape>
    </item>

    <!-- Top glossy specular shine -->
    <item
        android:left="4dp"
        android:right="4dp"
        android:top="1dp"
        android:bottom="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <gradient
                android:angle="270"
                android:startColor="#B0FFFFFF"
                android:endColor="#10FFFFFF" />
        </shape>
    </item>
</layer-list>
