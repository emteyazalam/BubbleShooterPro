<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom Shadow / Bevel -->
    <item
        android:left="0dp"
        android:right="0dp"
        android:top="4dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#40000000" />
        </shape>
    </item>

    <!-- 3D Emerald Rim -->
    <item
        android:left="0dp"
        android:right="0dp"
        android:top="0dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#14532D" />
        </shape>
    </item>

    <!-- Main Card Body -->
    <item
        android:left="0dp"
        android:right="0dp"
        android:top="0dp"
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="135"
                android:startColor="#1B382B"
                android:centerColor="#162238"
                android:endColor="#0F172A" />
            <stroke
                android:width="2dp"
                android:color="#4ADE80" />
        </shape>
    </item>
</layer-list>
