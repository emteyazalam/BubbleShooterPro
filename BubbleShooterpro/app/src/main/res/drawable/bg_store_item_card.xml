<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom 3D Drop Shadow -->
    <item
        android:top="3dp"
        android:left="0dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#26000000" />
        </shape>
    </item>

    <!-- 3D Bevel Rim -->
    <item
        android:top="0dp"
        android:left="0dp"
        android:right="0dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#CBD5E1" />
        </shape>
    </item>

    <!-- Card Face Surface -->
    <item
        android:top="0dp"
        android:left="0dp"
        android:right="0dp"
        android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#FFFFFF" />
            <stroke
                android:width="1.5dp"
                android:color="#E2E8F0" />
        </shape>
    </item>
</layer-list>
