<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 3D Base Drop Shadow -->
    <item android:top="6dp">
        <shape android:shape="oval">
            <solid android:color="#0A361B" />
        </shape>
    </item>

    <!-- Outer Golden Bevel Rim -->
    <item android:bottom="4dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#FEF08A"
                android:endColor="#84CC16" />
            <stroke android:width="2.5dp" android:color="#FACC15" />
        </shape>
    </item>

    <!-- Main Glossy Emerald Body -->
    <item android:top="3.5dp" android:bottom="7.5dp" android:left="3.5dp" android:right="3.5dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#4ADE80"
                android:centerColor="#22C55E"
                android:endColor="#15803D" />
        </shape>
    </item>

    <!-- Top Specular Gloss Highlight -->
    <item android:top="5dp" android:bottom="44dp" android:left="14dp" android:right="14dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#C0FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
