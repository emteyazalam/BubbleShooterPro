<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="56dp"
    android:height="56dp"
    android:viewportWidth="56"
    android:viewportHeight="56">

    <!-- 1. Deep 3D Drop Shadow Base -->
    <path
        android:pathData="M28,8 A22,22 0 1,0 28,52 A22,22 0 1,0 28,8 Z"
        android:fillColor="#451A03" />

    <!-- 2. Outer Golden Bevel Rim -->
    <path
        android:pathData="M28,5 A22,22 0 1,0 28,49 A22,22 0 1,0 28,5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="28"
                android:startY="5"
                android:endX="28"
                android:endY="49"
                android:type="linear">
                <item android:offset="0" android:color="#FFFDE047" />
                <item android:offset="0.5" android:color="#FFF59E0B" />
                <item android:offset="1" android:color="#FFB45309" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. Inner Dark Crease -->
    <path
        android:pathData="M28,6 A20,20 0 1,0 28,46 A20,20 0 1,0 28,6 Z"
        android:fillColor="#78350F" />

    <!-- 4. Main 3D Spherical Face with Radial Light Source -->
    <path
        android:pathData="M28,6.5 A19,19 0 1,0 28,44.5 A19,19 0 1,0 28,6.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="28"
                android:centerY="20"
                android:gradientRadius="22"
                android:type="radial">
                <item android:offset="0" android:color="#FFFEF08A" />
                <item android:offset="0.4" android:color="#FFFBBF24" />
                <item android:offset="0.8" android:color="#FFF59E0B" />
                <item android:offset="1" android:color="#FFD97706" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 5. Top Specular Highlight Arc -->
    <path
        android:pathData="M16,14 C19,8.5 37,8.5 40,14 C35,18.5 21,18.5 16,14 Z"
        android:fillColor="#80FFFFFF" />

    <!-- 6. Top Specular Glint Dot -->
    <path
        android:pathData="M28,9.5 A1.8,1.8 0 1,0 28,13.1 A1.8,1.8 0 1,0 28,9.5 Z"
        android:fillColor="#A0FFFFFF" />

    <!-- 7. Bottom Rim Bounce Light Sheen -->
    <path
        android:pathData="M20,40.5 C24,42.8 32,42.8 36,40.5 C33,41.8 23,41.8 20,40.5 Z"
        android:fillColor="#45FEF08A" />

    <!-- 8. Bold Rounded 'X' Drop Shadow -->
    <path
        android:pathData="M20,20.8 L36,36.8 M36,20.8 L20,36.8"
        android:strokeColor="#78350F"
        android:strokeWidth="5.5"
        android:strokeLineCap="round" />

    <!-- 9. Bold Rounded 'X' Foreground (Brilliant White) -->
    <path
        android:pathData="M20,19 L36,35 M36,19 L20,35"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5.5"
        android:strokeLineCap="round" />
</vector>
