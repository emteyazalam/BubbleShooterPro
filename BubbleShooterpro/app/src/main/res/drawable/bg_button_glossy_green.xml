<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#80FFFFFF">
    <item>
        <layer-list>
            <!-- Bottom shadow for 3D depth -->
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <solid android:color="#0D5C2C" />
                </shape>
            </item>
            <!-- Main button body with vertical gradient -->
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#4ADE80"
                        android:centerColor="#22C55E"
                        android:endColor="#16A34A" />
                    <stroke
                        android:width="2dp"
                        android:color="#15803D" />
                </shape>
            </item>
            <!-- Top glossy specular sheen -->
            <item android:bottom="20dp" android:left="6dp" android:right="6dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:topLeftRadius="20dp" android:topRightRadius="20dp" android:bottomLeftRadius="6dp" android:bottomRightRadius="6dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#90FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
