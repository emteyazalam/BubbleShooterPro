<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="45dp"
                        android:startColor="#60A5FA"
                        android:centerColor="#2563EB"
                        android:endColor="#1E3A8A" />
                    <stroke
                        android:width="2dp"
                        android:color="#93C5FD" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- 3D Shadow -->
            <item android:top="3dp">
                <shape android:shape="oval">
                    <solid android:color="#1E3A8A" />
                </shape>
            </item>
            <!-- Main Circle -->
            <item android:bottom="3dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="40dp"
                        android:startColor="#93C5FD"
                        android:centerColor="#3B82F6"
                        android:endColor="#1D4ED8" />
                    <stroke
                        android:width="2dp"
                        android:color="#FFFFFF" />
                </shape>
            </item>
            <!-- Top Shine Specular -->
            <item android:top="4dp" android:left="8dp" android:right="8dp" android:bottom="20dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#A0FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
