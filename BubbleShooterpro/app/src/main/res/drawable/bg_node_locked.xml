<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom Drop Shadow -->
    <item
        android:left="0dp"
        android:right="0dp"
        android:top="4dp"
        android:bottom="0dp">
        <shape android:shape="oval">
            <solid android:color="#334155" />
        </shape>
    </item>

    <!-- Main Silver Stone Face -->
    <item
        android:left="0dp"
        android:right="0dp"
        android:top="0dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#F1F5F9"
                android:centerColor="#CBD5E1"
                android:endColor="#94A3B8" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
