<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Pulsing Glow Aura -->
    <item
        android:left="0dp"
        android:right="0dp"
        android:top="0dp"
        android:bottom="0dp">
        <shape android:shape="oval">
            <solid android:color="#4038BDF8" />
            <stroke
                android:width="3dp"
                android:color="#7DD3FC" />
        </shape>
    </item>

    <!-- Bottom 3D Drop Bevel -->
    <item
        android:left="4dp"
        android:right="4dp"
        android:top="9dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#0F5132" />
        </shape>
    </item>

    <!-- Main Glossy Vibrant Emerald Face -->
    <item
        android:left="4dp"
        android:right="4dp"
        android:top="4dp"
        android:bottom="9dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#86EFAC"
                android:centerColor="#22C55E"
                android:endColor="#15803D" />
            <stroke
                android:width="3dp"
                android:color="#FFFFFF" />
        </shape>
    </item>

    <!-- Specular Highlight -->
    <item
        android:left="14dp"
        android:right="14dp"
        android:top="7dp"
        android:bottom="30dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#D0FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
