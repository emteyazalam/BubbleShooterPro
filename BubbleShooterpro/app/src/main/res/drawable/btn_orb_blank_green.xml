<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="45dp"
                        android:startColor="#4ADE80"
                        android:centerColor="#16A34A"
                        android:endColor="#14532D" />
                    <stroke
                        android:width="2dp"
                        android:color="#86EFAC" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- 3D Shadow -->
            <item android:top="3dp">
                <shape android:shape="oval">
                    <solid android:color="#0F5132" />
                </shape>
            </item>
            <!-- Main Circle -->
            <item android:bottom="3dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="40dp"
                        android:startColor="#86EFAC"
                        android:centerColor="#22C55E"
                        android:endColor="#15803D" />
                    <stroke
                        android:width="2dp"
                        android:color="#FFFFFF" />
                </shape>
            </item>
            <!-- Top Shine Specular -->
            <item android:top="4dp" android:left="8dp" android:right="8dp" android:bottom="20dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#A0FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
