<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom 3D Drop Bevel -->
    <item
        android:left="0dp"
        android:right="0dp"
        android:top="5dp"
        android:bottom="0dp">
        <shape android:shape="oval">
            <solid android:color="#14532D" />
        </shape>
    </item>

    <!-- Main Glossy Green Orb Face -->
    <item
        android:left="0dp"
        android:right="0dp"
        android:top="0dp"
        android:bottom="5dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#4ADE80"
                android:centerColor="#22C55E"
                android:endColor="#16A34A" />
            <stroke
                android:width="2.5dp"
                android:color="#FFFFFF" />
        </shape>
    </item>

    <!-- Specular Sheen -->
    <item
        android:left="10dp"
        android:right="10dp"
        android:top="3dp"
        android:bottom="26dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#B0FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
