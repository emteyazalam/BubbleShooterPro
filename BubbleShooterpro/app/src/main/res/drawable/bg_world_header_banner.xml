<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 3D Base Drop Shadow -->
    <item
        android:top="3dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#50000000" />
        </shape>
    </item>

    <!-- Outer Gold / Amber Bevel Border Plaque -->
    <item
        android:top="0dp"
        android:left="0dp"
        android:right="0dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#FDE047"
                android:endColor="#D97706" />
        </shape>
    </item>

    <!-- Main Royal Navy Plaque Body -->
    <item
        android:top="1.8dp"
        android:left="1.8dp"
        android:right="1.8dp"
        android:bottom="4.8dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#1E293B"
                android:centerColor="#0F172A"
                android:endColor="#0B1120" />
        </shape>
    </item>

    <!-- Top Specular Gloss Highlight -->
    <item
        android:top="3dp"
        android:left="12dp"
        android:right="12dp"
        android:bottom="16dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="12dp"
                android:topRightRadius="12dp"
                android:bottomLeftRadius="4dp"
                android:bottomRightRadius="4dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
