<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#9333EA"
                android:endColor="#581C87" />
            <corners android:radius="24dp" />
            <stroke
                android:width="2dp"
                android:color="#E9D5FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#C084FC"
                android:centerColor="#9333EA"
                android:endColor="#6B21A8" />
            <corners android:radius="24dp" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFF" />
        </shape>
    </item>
</selector>
