<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="45dp"
                        android:startColor="#F87171"
                        android:centerColor="#DC2626"
                        android:endColor="#7F1D1D" />
                    <stroke
                        android:width="2dp"
                        android:color="#FECACA" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- 3D Shadow -->
            <item android:top="3dp">
                <shape android:shape="oval">
                    <solid android:color="#450A0A" />
                </shape>
            </item>
            <!-- Main Circle -->
            <item android:bottom="3dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="40dp"
                        android:startColor="#FCA5A5"
                        android:centerColor="#EF4444"
                        android:endColor="#B91C1C" />
                    <stroke
                        android:width="2dp"
                        android:color="#FFFFFF" />
                </shape>
            </item>
            <!-- Top Shine Specular -->
            <item android:top="4dp" android:left="8dp" android:right="8dp" android:bottom="20dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#A0FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
