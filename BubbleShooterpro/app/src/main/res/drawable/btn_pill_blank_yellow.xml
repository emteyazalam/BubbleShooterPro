<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="30dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#EAB308"
                        android:centerColor="#CA8A04"
                        android:endColor="#A16207" />
                    <stroke
                        android:width="2.5dp"
                        android:color="#FEF08A" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Default state -->
    <item>
        <layer-list>
            <!-- 3D Bottom Drop Bevel -->
            <item android:top="6dp">
                <shape android:shape="rectangle">
                    <corners android:radius="30dp" />
                    <solid android:color="#78350F" />
                </shape>
            </item>
            <!-- Main Button Body with Crisp Outer Stroke -->
            <item android:bottom="6dp">
                <shape android:shape="rectangle">
                    <corners android:radius="30dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#FACC15"
                        android:centerColor="#EAB308"
                        android:endColor="#CA8A04" />
                    <stroke
                        android:width="2.5dp"
                        android:color="#FFFFFF" />
                </shape>
            </item>
            <!-- Top Specular Crescent Sheen -->
            <item android:bottom="24dp" android:left="8dp" android:right="8dp" android:top="3dp">
                <shape android:shape="rectangle">
                    <corners android:topLeftRadius="24dp" android:topRightRadius="24dp" android:bottomLeftRadius="8dp" android:bottomRightRadius="8dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#B0FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
