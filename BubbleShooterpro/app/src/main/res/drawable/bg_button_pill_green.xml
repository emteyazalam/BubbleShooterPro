<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#80FFFFFF">
    <item>
        <layer-list>
            <!-- 3D Bottom Drop Bevel -->
            <item android:top="6dp">
                <shape android:shape="rectangle">
                    <corners android:radius="30dp" />
                    <solid android:color="#0F5132" />
                </shape>
            </item>
            <!-- Main Button Body with Crisp Outer White Rim -->
            <item android:bottom="6dp">
                <shape android:shape="rectangle">
                    <corners android:radius="30dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#4ADE80"
                        android:centerColor="#22C55E"
                        android:endColor="#15803D" />
                    <stroke
                        android:width="3dp"
                        android:color="#FFFFFF" />
                </shape>
            </item>
            <!-- Top Specular Crescent Sheen -->
            <item android:bottom="24dp" android:left="10dp" android:right="10dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <corners android:topLeftRadius="24dp" android:topRightRadius="24dp" android:bottomLeftRadius="8dp" android:bottomRightRadius="8dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#B0FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
