<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom 3D Drop Shadow -->
    <item
        android:top="3dp"
        android:left="0dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#33000000" />
        </shape>
    </item>

    <!-- 3D Bevel Rim (Amber/Gold) -->
    <item
        android:top="0dp"
        android:left="0dp"
        android:right="0dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#D97706" />
        </shape>
    </item>

    <!-- Card Face Surface (Light golden cream) -->
    <item
        android:top="0dp"
        android:left="0dp"
        android:right="0dp"
        android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#FFFBEB" />
            <stroke
                android:width="2dp"
                android:color="#F59E0B" />
        </shape>
    </item>
</layer-list>
