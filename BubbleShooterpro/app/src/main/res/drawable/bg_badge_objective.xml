<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 3D Bottom Drop Shadow -->
    <item
        android:top="3dp"
        android:bottom="0dp"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#50000000" />
        </shape>
    </item>

    <!-- Main Plaque Cartridge Body with Gold/Amber Rim -->
    <item
        android:top="0dp"
        android:bottom="3dp"
        android:left="0dp"
        android:right="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="#1E293B"
                android:centerColor="#0F172A"
                android:endColor="#0A0E1A" />
            <stroke
                android:width="1.8dp"
                android:color="#F59E0B" />
        </shape>
    </item>

    <!-- Top Specular Gloss Sheen -->
    <item
        android:top="1.5dp"
        android:bottom="14dp"
        android:left="6dp"
        android:right="6dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="14dp"
                android:topRightRadius="14dp"
                android:bottomLeftRadius="4dp"
                android:bottomRightRadius="4dp" />
            <gradient
                android:angle="270"
                android:startColor="#35FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
