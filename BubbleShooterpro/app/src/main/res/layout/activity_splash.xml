<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Cinematic Bubble Shoot & Scatter Animation View -->
    <com.redcodersgroup.bubbleshooter.ui.splash.SplashAnimationView
        android:id="@+id/splashAnimationView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Small Branding at the Bottom -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/dp_28"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="POWERED BY"
            android:textColor="#80FFFFFF"
            android:textSize="@dimen/sp_10"
            android:textStyle="bold"
            android:letterSpacing="0.25" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/dp_2">

            <!-- Red Dot Brand Accent -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RED CODERS GROUP"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/sp_13"
                android:textStyle="bold"
                android:letterSpacing="0.15" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
