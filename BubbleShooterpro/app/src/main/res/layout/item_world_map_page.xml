<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutWorldContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Full-screen edge-to-edge background (No scrolling, no zooming in) -->
    <ImageView
        android:id="@+id/ivWorldBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="World Map Background" />

    <!-- Overlay container for Level Orbs and Gift Chests -->
    <FrameLayout
        android:id="@+id/layoutNodesOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false" />

</FrameLayout>
