<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@drawable/bg_card_dialog">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/level_complete"
        android:textColor="@color/accent_yellow"
        android:textSize="26sp"
        android:textStyle="bold"
        android:shadowColor="#B0000000"
        android:shadowDx="2"
        android:shadowDy="3"
        android:shadowRadius="6" />

    <TextView
        android:id="@+id/tvWinObjectiveSummary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="✓ All bubbles cleared!"
        android:textColor="#E0F7FA"
        android:textSize="13.5sp"
        android:textStyle="bold" />

    <!-- 3 Big Victory Stars -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/ivWinStar1"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:src="@drawable/ic_star_empty" />

        <ImageView
            android:id="@+id/ivWinStar2"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_star_empty" />

        <ImageView
            android:id="@+id/ivWinStar3"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:src="@drawable/ic_star_empty" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvWinScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SCORE: 3,450"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWinHighScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="HIGH SCORE: 3,450"
        android:textColor="#A0E0E0E0"
        android:textSize="14sp" />

    <!-- Buttons: Next Level, Replay, Home -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="24dp">

        <ImageButton
            android:id="@+id/btnWinHome"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/btn_home_yellow"
            android:contentDescription="Home" />

        <ImageButton
            android:id="@+id/btnWinRestart"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/btn_restart_yellow"
            android:contentDescription="Replay" />

        <ImageButton
            android:id="@+id/btnWinNext"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/btn_play_green"
            android:contentDescription="Next Level" />
    </LinearLayout>

</LinearLayout>
