<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="@dimen/dp_24"
    android:background="@drawable/bg_card_dialog">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/level_complete"
        android:textColor="@color/accent_yellow"
        android:textSize="@dimen/sp_26"
        android:textStyle="bold"
        android:shadowColor="#B0000000"
        android:shadowDx="2"
        android:shadowDy="3"
        android:shadowRadius="6" />

    <TextView
        android:id="@+id/tvWinObjectiveSummary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:text="✓ All bubbles cleared!"
        android:textColor="#E0F7FA"
        android:textSize="@dimen/sp_14"
        android:textStyle="bold" />

    <!-- 3 Big Victory Stars -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_16">

        <ImageView
            android:id="@+id/ivWinStar1"
            android:layout_width="@dimen/dp_54"
            android:layout_height="@dimen/dp_54"
            android:src="@drawable/ic_star_empty" />

        <ImageView
            android:id="@+id/ivWinStar2"
            android:layout_width="@dimen/dp_68"
            android:layout_height="@dimen/dp_68"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_8"
            android:src="@drawable/ic_star_empty" />

        <ImageView
            android:id="@+id/ivWinStar3"
            android:layout_width="@dimen/dp_54"
            android:layout_height="@dimen/dp_54"
            android:src="@drawable/ic_star_empty" />
    </LinearLayout>

    <!-- Shots Left Bonus Breakdown Card -->
    <LinearLayout
        android:id="@+id/layoutWinShotsBonus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_badge_objective"
        android:layout_marginTop="@dimen/dp_2"
        android:layout_marginBottom="@dimen/dp_12"
        android:paddingStart="@dimen/dp_14"
        android:paddingEnd="@dimen/dp_14"
        android:paddingTop="@dimen/dp_7"
        android:paddingBottom="@dimen/dp_7">

        <TextView
            android:id="@+id/tvWinShotsBonusTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎯 REMAINING SHOTS BONUS"
            android:textColor="#FFD54F"
            android:textSize="@dimen/sp_12"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/tvWinShotsBonusCalculation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"
            android:text="+1,200 Bonus (12 Shots Left × 100 pts)"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/sp_14"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvWinScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SCORE: 3,450"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/sp_22"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWinHighScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:text="HIGH SCORE: 3,450"
        android:textColor="#A0E0E0E0"
        android:textSize="@dimen/sp_14" />

    <!-- Buttons: Next Level, Replay, Home -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="@dimen/dp_24">

        <ImageButton
            android:id="@+id/btnWinHome"
            android:layout_width="@dimen/dp_58"
            android:layout_height="@dimen/dp_58"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/btn_home_yellow"
            android:contentDescription="Home" />

        <ImageButton
            android:id="@+id/btnWinRestart"
            android:layout_width="@dimen/dp_58"
            android:layout_height="@dimen/dp_58"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/btn_restart_yellow"
            android:contentDescription="Replay" />

        <ImageButton
            android:id="@+id/btnWinNext"
            android:layout_width="@dimen/dp_72"
            android:layout_height="@dimen/dp_72"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/btn_play_green"
            android:contentDescription="Next Level" />
    </LinearLayout>

</LinearLayout>
