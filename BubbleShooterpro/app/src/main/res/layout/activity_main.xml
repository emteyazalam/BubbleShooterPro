<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_home_gradient"
    android:clipToPadding="false"
    android:clipChildren="false"
    android:paddingStart="@dimen/dp_16"
    android:paddingEnd="@dimen/dp_16"
    android:paddingTop="@dimen/dp_36"
    android:paddingBottom="@dimen/dp_24">

    <!-- Top Bar: Settings Button on Top Right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Space
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_1"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnMainSettings"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/btn_settings_yellow"
            android:contentDescription="Settings" />
    </LinearLayout>

    <Space
        android:layout_width="@dimen/dp_1"
        android:layout_height="0dp"
        android:layout_weight="0.8" />

    <!-- Hero Title Banner -->
    <LinearLayout
        android:id="@+id/titleContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Decorative Accents -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/dp_4">

            <ImageView
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:src="@drawable/rainbow_bubble" />

            <ImageView
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:layout_marginStart="@dimen/dp_8"
                android:layout_marginEnd="@dimen/dp_8"
                android:src="@drawable/ic_star_filled" />

            <ImageView
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:src="@drawable/bomb_bubble" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BUBBLE\nSHOOTER"
            android:textAlignment="center"
            android:textColor="@color/accent_yellow"
            android:textSize="@dimen/sp_38"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:shadowColor="#D0000000"
            android:shadowDx="3"
            android:shadowDy="5"
            android:shadowRadius="10" />

        <!-- Subtitle Badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦ PRO EDITION ✦"
            android:textColor="@color/accent_pink"
            android:textSize="@dimen/sp_13"
            android:textStyle="bold"
            android:letterSpacing="0.25"
            android:layout_marginTop="@dimen/dp_2" />
    </LinearLayout>

    <Space
        android:layout_width="@dimen/dp_1"
        android:layout_height="0dp"
        android:layout_weight="1.2" />

    <!-- Dual Game Modes Showcase (Adventure & Endless) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. Adventure Mode Card -->
        <LinearLayout
            android:id="@+id/cardModeAdventure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_adventure"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            android:paddingTop="@dimen/dp_12"
            android:paddingBottom="@dimen/dp_12"
            android:clickable="true"
            android:focusable="true">

            <!-- Badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_saga"
                android:text="⭐ SAGA"
                android:textColor="#FDE047"
                android:textSize="@dimen/sp_10"
                android:textStyle="bold"
                android:paddingStart="@dimen/dp_7"
                android:paddingEnd="@dimen/dp_7"
                android:paddingTop="@dimen/dp_2"
                android:paddingBottom="@dimen/dp_2"
                android:layout_marginBottom="@dimen/dp_4" />

            <!-- Card Body -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ADVENTURE"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/sp_16"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvModeLevelStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Level 1 • 30 Levels"
                        android:textColor="#94A3B8"
                        android:textSize="@dimen/sp_11"
                        android:layout_marginTop="@dimen/dp_2" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnMainPlay"
                    android:layout_width="@dimen/dp_94"
                    android:layout_height="@dimen/dp_46"
                    android:background="@drawable/btn_pill_blank_green"
                    android:text="▶ PLAY"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Footer: Map Link -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/dp_8"
                android:paddingTop="@dimen/dp_4">

                <TextView
                    android:id="@+id/btnMainLevels"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_map_link_btn"
                    android:text="🗺️ Select Level / Map"
                    android:textColor="#FDE047"
                    android:textSize="@dimen/sp_11"
                    android:textStyle="bold"
                    android:paddingStart="@dimen/dp_9"
                    android:paddingEnd="@dimen/dp_9"
                    android:paddingTop="@dimen/dp_3"
                    android:paddingBottom="@dimen/dp_3"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. Endless Mode Card -->
        <LinearLayout
            android:id="@+id/cardModeEndless"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/dp_12"
            android:background="@drawable/bg_card_endless"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            android:paddingTop="@dimen/dp_12"
            android:paddingBottom="@dimen/dp_12"
            android:clickable="true"
            android:focusable="true">

            <!-- Badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_endless"
                android:text="⚡ INFINITE"
                android:textColor="#F0ABFC"
                android:textSize="@dimen/sp_10"
                android:textStyle="bold"
                android:paddingStart="@dimen/dp_7"
                android:paddingEnd="@dimen/dp_7"
                android:paddingTop="@dimen/dp_2"
                android:paddingBottom="@dimen/dp_2"
                android:layout_marginBottom="@dimen/dp_4" />

            <!-- Card Body -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Infinity Box Icon -->
                <LinearLayout
                    android:layout_width="@dimen/dp_38"
                    android:layout_height="@dimen/dp_38"
                    android:background="@drawable/bg_infinity_box"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="∞"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/sp_24"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:layout_marginTop="-2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_10"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ENDLESS"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/sp_16"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEndlessHighScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏆 Best: 0 pts • Survival"
                        android:textColor="#67E8F9"
                        android:textSize="@dimen/sp_11"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/dp_2" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnMainEndless"
                    android:layout_width="@dimen/dp_94"
                    android:layout_height="@dimen/dp_46"
                    android:background="@drawable/btn_pill_purple"
                    android:text="⚡ PLAY"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <Space
        android:layout_width="@dimen/dp_1"
        android:layout_height="0dp"
        android:layout_weight="1.0" />

</LinearLayout>