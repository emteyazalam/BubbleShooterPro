<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="6dp">

    <FrameLayout
        android:id="@+id/layoutBadge"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_button_glossy_yellow">

        <TextView
            android:id="@+id/tvLevelNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="1"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <ImageView
            android:id="@+id/ivLock"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_lock"
            android:visibility="gone" />

        <!-- Pulsating Current Level Indicator Badge -->
        <TextView
            android:id="@+id/tvHereTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="-4dp"
            android:background="@drawable/bg_badge_here"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:text="HERE!"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 3 Stars earned -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <ImageView
            android:id="@+id/ivStar1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_star_empty" />

        <ImageView
            android:id="@+id/ivStar2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="2dp"
            android:src="@drawable/ic_star_empty" />

        <ImageView
            android:id="@+id/ivStar3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="2dp"
            android:src="@drawable/ic_star_empty" />
    </LinearLayout>

</LinearLayout>
