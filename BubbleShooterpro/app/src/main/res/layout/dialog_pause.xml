<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="@dimen/dp_24"
    android:background="@drawable/bg_card_dialog">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/paused"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/sp_26"
        android:textStyle="bold"
        android:shadowColor="#B0000000"
        android:shadowDx="2"
        android:shadowDy="3"
        android:shadowRadius="6" />

    <!-- Top Horizontal Row: Sound, Haptic, Home -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginBottom="@dimen/dp_20">

        <ImageButton
            android:id="@+id/btnToggleSound"
            android:layout_width="@dimen/dp_54"
            android:layout_height="@dimen/dp_54"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/btn_sound_green"
            android:contentDescription="@string/sound" />

        <ImageButton
            android:id="@+id/btnToggleHaptic"
            android:layout_width="@dimen/dp_54"
            android:layout_height="@dimen/dp_54"
            android:layout_marginStart="@dimen/dp_16"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/btn_vibration_yellow"
            android:contentDescription="@string/haptics" />

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="@dimen/dp_54"
            android:layout_height="@dimen/dp_54"
            android:layout_marginStart="@dimen/dp_16"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/btn_home_yellow"
            android:contentDescription="@string/home" />
    </LinearLayout>

    <!-- Vertical Buttons in top-to-down order: Levels, Restart, Resume -->

    <!-- 1. Levels Button (Top) -->
    <Button
        android:id="@+id/btnLevels"
        android:layout_width="@dimen/dp_200"
        android:layout_height="@dimen/dp_54"
        android:background="@drawable/btn_pill_blank_blue"
        android:text="@string/levels"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/sp_18"
        android:textStyle="bold" />

    <!-- 2. Restart Button (Middle) -->
    <Button
        android:id="@+id/btnRestart"
        android:layout_width="@dimen/dp_200"
        android:layout_height="@dimen/dp_54"
        android:layout_marginTop="@dimen/dp_12"
        android:background="@drawable/btn_pill_blank_yellow"
        android:text="@string/restart"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/sp_18"
        android:textStyle="bold" />

    <!-- 3. Resume Button (Bottom) -->
    <Button
        android:id="@+id/btnResume"
        android:layout_width="@dimen/dp_200"
        android:layout_height="@dimen/dp_54"
        android:layout_marginTop="@dimen/dp_12"
        android:background="@drawable/btn_pill_blank_green"
        android:text="@string/resume"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/sp_18"
        android:textStyle="bold" />

</LinearLayout>
