<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="@dimen/dp_24"
    android:background="@drawable/bg_card_dialog">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/game_over"
        android:textColor="@color/accent_pink"
        android:textSize="@dimen/sp_26"
        android:textStyle="bold"
        android:shadowColor="#B0000000"
        android:shadowDx="2"
        android:shadowDy="3"
        android:shadowRadius="6" />

    <TextView
        android:id="@+id/tvLoseSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:text="Out of shots! Don't give up!"
        android:textColor="#E0E0E0"
        android:textSize="@dimen/sp_15" />

    <TextView
        android:id="@+id/tvLoseScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="FINAL SCORE: 1,200"
        android:textColor="@color/accent_yellow"
        android:textSize="@dimen/sp_20"
        android:textStyle="bold" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="@dimen/dp_24">

        <ImageButton
            android:id="@+id/btnLoseHome"
            android:layout_width="@dimen/dp_58"
            android:layout_height="@dimen/dp_58"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/btn_home_yellow"
            android:contentDescription="Home" />

        <ImageButton
            android:id="@+id/btnLoseRetry"
            android:layout_width="@dimen/dp_68"
            android:layout_height="@dimen/dp_68"
            android:layout_marginStart="@dimen/dp_20"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/btn_restart_green"
            android:contentDescription="Retry" />
    </LinearLayout>

</LinearLayout>
