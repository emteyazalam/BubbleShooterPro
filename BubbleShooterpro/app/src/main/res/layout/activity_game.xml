<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- The Custom Canvas Game View (Fills full screen) -->
    <com.redcodersgroup.bubbleshooter.ui.BubbleGameView
        android:id="@+id/bubbleGameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top HUD Overlay (Cleanly positioned above ceiling line with camera cutout safe padding) -->
    <LinearLayout
        android:id="@+id/topHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="36dp"
        android:paddingBottom="10dp">

        <!-- Pause Button -->
        <ImageButton
            android:id="@+id/btnPause"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/btn_pause_yellow"
            android:contentDescription="Pause" />

        <!-- Star Stage Progress and Level/Score Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp">

            <!-- Top Row: Level Badge Pill + Score -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvLevelTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_level_pill"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="LVL 1"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SCORE: 0"
                    android:textColor="@color/accent_yellow"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:shadowColor="#80000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2" />
            </LinearLayout>

            <!-- Bottom Row: Star Stage Progress Bar Track + 3 Milestone Nodes -->
            <FrameLayout
                android:id="@+id/layoutStarProgressTrack"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="3dp">

                <ProgressBar
                    android:id="@+id/pbStarProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_gravity="center_vertical"
                    android:max="1000"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_star_stage_track" />

                <!-- Milestone Node 1 -->
                <FrameLayout
                    android:id="@+id/hudStarNode1"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/bg_hud_star_node">

                    <ImageView
                        android:id="@+id/hudStar1"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_star_empty" />
                </FrameLayout>

                <!-- Milestone Node 2 -->
                <FrameLayout
                    android:id="@+id/hudStarNode2"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/bg_hud_star_node">

                    <ImageView
                        android:id="@+id/hudStar2"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_star_empty" />
                </FrameLayout>

                <!-- Milestone Node 3 -->
                <FrameLayout
                    android:id="@+id/hudStarNode3"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/bg_hud_star_node">

                    <ImageView
                        android:id="@+id/hudStar3"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_star_empty" />
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Shots Remaining Badge -->
        <LinearLayout
            android:id="@+id/layoutShots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_button_glossy_green"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="3dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/tvShotsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvShotsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SHOTS"
                android:textColor="#E0FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Boosters Bar (Clean horizontal row of 4 mod boosters with bubble count badges) -->
    <LinearLayout
        android:id="@+id/bottomBoosters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="25dp">

        <!-- Rainbow Booster -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">

            <FrameLayout
                android:id="@+id/layoutBoosterRainbow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageButton
                    android:id="@+id/btnBoosterRainbow"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_circle_transparent"
                    android:scaleType="fitCenter"
                    android:padding="2dp"
                    android:src="@drawable/rainbow_bubble"
                    android:contentDescription="Rainbow Booster" />

                <!-- Bubble badge for count -->
                <TextView
                    android:id="@+id/tvCountRainbow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:minWidth="18dp"
                    android:minHeight="18dp"
                    android:gravity="center"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:background="@drawable/bg_booster_badge"
                    android:text="∞"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:elevation="6dp" />
            </FrameLayout>
        </LinearLayout>

        <!-- Fireball Booster -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">

            <FrameLayout
                android:id="@+id/layoutBoosterFireball"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageButton
                    android:id="@+id/btnBoosterFireball"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_circle_transparent"
                    android:scaleType="fitCenter"
                    android:padding="2dp"
                    android:src="@drawable/fireball_bubble"
                    android:contentDescription="Fireball Booster" />

                <!-- Bubble badge for count -->
                <TextView
                    android:id="@+id/tvCountFireball"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:minWidth="18dp"
                    android:minHeight="18dp"
                    android:gravity="center"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:background="@drawable/bg_booster_badge"
                    android:text="∞"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:elevation="6dp" />
            </FrameLayout>
        </LinearLayout>

        <!-- Lightning Booster -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">

            <FrameLayout
                android:id="@+id/layoutBoosterLightning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageButton
                    android:id="@+id/btnBoosterLightning"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_circle_transparent"
                    android:scaleType="fitCenter"
                    android:padding="2dp"
                    android:src="@drawable/lightning_bubble"
                    android:contentDescription="Lightning Booster" />

                <!-- Bubble badge for count -->
                <TextView
                    android:id="@+id/tvCountLightning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:minWidth="18dp"
                    android:minHeight="18dp"
                    android:gravity="center"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:background="@drawable/bg_booster_badge"
                    android:text="∞"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:elevation="6dp" />
            </FrameLayout>
        </LinearLayout>

        <!-- Bomb Booster -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">

            <FrameLayout
                android:id="@+id/layoutBoosterBomb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageButton
                    android:id="@+id/btnBoosterBomb"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_circle_transparent"
                    android:scaleType="fitCenter"
                    android:padding="2dp"
                    android:src="@drawable/bomb_bubble"
                    android:contentDescription="Bomb Booster" />

                <!-- Bubble badge for count -->
                <TextView
                    android:id="@+id/tvCountBomb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:minWidth="18dp"
                    android:minHeight="18dp"
                    android:gravity="center"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:background="@drawable/bg_booster_badge"
                    android:text="∞"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:elevation="6dp" />
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
